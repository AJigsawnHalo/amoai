# ==========================================
# 1. DISCORD CONFIGURATION
# ==========================================
DISCORD_BOT_TOKEN=""
ALLOWED_CHANNEL_ID=""
DISCORD_USER_ID=""
# Distinct Webhook URLs for your channels
WEBHOOK_EMAIL=""


# ==========================================
# 2. LOCAL LLM CONFIGURATION (Ollama Chat API)
# ==========================================
OLLAMA_API=http://localhost:11434/api/chat


# ==========================================
# 3. EMAIL MONITOR CONFIGURATION
# ==========================================
# Keep the single quotes surrounding the brackets to safely pass the JSON list format to Python
EMAIL_ACCOUNTS='[

        {
            "user": "",
            "password": ""
        },
        {
            "user": "",
            "password": ""
        },
        {
            "user": "",
            "password": ""
        },
        {
            "user": "",
            "password": ""
        }
]'


# ==========================================
# 4. SEARXNG CONFIGURATION
# ==========================================
SEARXNG_URL=""

# ==========================================
# 5. HOME ASSISTANT CONFIGURATION
# ==========================================
HA_URL=""
HA_TOKEN=""
ARRIVAL_WEBHOOK_SECRET=""
ARRIVAL_WEBHOOK_PORT=8787

# ==========================================
# 6. GEMINI CONFIGURATION
# ==========================================
GEMINI_API_KEY=""

# ==========================================
# 7. SYSTEM TOOL SAFETY (restart allowlists)
# ==========================================
# Comma-separated exact names. Empty/unset = nothing is restartable —
# these tools are LLM-callable, so leave blank unless you actually want
# amoai to be able to restart these.
ALLOWED_RESTART_SERVICES=""
CONTAINER_RESTART_ALLOWLIST=""

# ==========================================
# 8. TOOL PATHS (only needed if not using the default install layout)
# ==========================================
NYAADLE_BIN=""
NYAADLE_LOG=""
EMAIL_SORT_VENV_PYTHON=""
EMAIL_SORT_SCRIPT_PATH=""

# ==========================================
# 9. EMBEDDING / RAG CONFIGURATION
# ==========================================
# Cloud embedding model used by the main bot (default: gemini-embedding-001)
EMBED_MODEL=""
# Local (Ollama) embedding fallback used by the main bot
LOCAL_EMBED_API="http://localhost:11434/api/embeddings"
LOCAL_EMBED_MODEL="nomic-embed-text"
# Local model used when the cloud LLM is unavailable
LOCAL_FALLBACK_MODEL="aliafshar/gemma3-it-qat-tools:1b"
# Embedding config used specifically by the RAG knowledge tool
OLLAMA_EMBED_API="http://localhost:11434/api/embeddings"
OLLAMA_EMBED_MODEL="nomic-embed-text"
# Max number of tool/knowledge results returned per query
TOOL_TOP_K=12
# Base directory the file/RAG tools are allowed to read from (default: home dir)
RAG_TOOL_BASE_DIR=""
FILE_TOOL_BASE_DIR=""

# ==========================================
# 10. GOOGLE CALENDAR CONFIGURATION
# ==========================================
GOOGLE_CALENDAR_CREDENTIALS_FILE=""
GOOGLE_CALENDAR_TOKEN_FILE=""
# Calendar ID to use by default (default: "primary")
GOOGLE_CALENDAR_ID="primary"
# Default behavior for "list all calendars" (default: "all")
GOOGLE_CALENDAR_LIST_DEFAULT="all"

# ==========================================
# 11. MORNING BRIEFING CONFIGURATION
# ==========================================
MORNING_BRIEFING_ENABLED="true"
# Hour of day (24h, local time) the briefing is sent (default: 6)
MORNING_BRIEFING_HOUR=6
# Location string used for the weather portion of the briefing
WEATHER_LOCATION=""

# ==========================================
# 12. SERVER HEALTH CHECK CONFIGURATION
# ==========================================
# Comma-separated list of services to include in health checks
HEALTH_CHECK_SERVICES=""

# ==========================================
# 13. JOB MANAGER CONFIGURATION
# ==========================================
JOB_CLASSIFIER_MODEL="gpt-oss:20b-cloud"

# ==========================================
# 14. LOG MONITOR CONFIGURATION
# ==========================================
# Falls back to WEBHOOK_EMAIL if unset
WEBHOOK_LOG=""
# JSON list of log sources to watch; falls back to a built-in default list if unset
LOG_SOURCES=""
LOG_MONITOR_MODEL="gpt-oss:20b-cloud"
LOG_MONITOR_STATE_FILE=""
LOG_MONITOR_LOCK_FILE=""
# Extra comma-separated keywords that count as critical
CRITICAL_KEYWORDS=""
# Minimum syslog priority treated as critical (default: "err")
CRITICAL_MIN_PRIORITY="err"
USE_LLM_CLASSIFICATION="false"
